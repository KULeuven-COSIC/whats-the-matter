	    (* | (!(out(c, w0)))  *)

		(* Leaking L causes proverif to have an internal error. We will be reporting that. *)
	    (* | (!(out(c, L)))  *)
		(* ------ *)

		(* ------ *)
		(* Claim: Forward Secrecy *)
		(* Leaking the password does not compromise previously established sessions *)
		
		(* Uncomment below to test for forward-secrecy *)
	    (* | (!(phase 1; out(c, pw)))  *)
		(* make sure the leaking lines from the previous claim just above are commented when testing
			for forward secrecy *)
		(* The password becomes obtainable by the attacker, but all previously secure values remain secure *)
		(* ------ *)
